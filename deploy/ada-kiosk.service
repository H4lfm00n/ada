# Template: scripts/kiosk-autostart.sh install fills @REPO@ and @UV@. Not enabled by default.
[Unit]
Description=AI Lab assistant kiosk server (ada)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/ada/kiosk.env
ExecStart=@UV@ run python -m app.server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
